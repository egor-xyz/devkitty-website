{
  "name": "devkitty-website",
  "description": "Devkitty: a native macOS workspace for Git, GitHub and your terminals",
  "version": "1.23.2",
  "private": true,
  "type": "module",
  "homepage": "https://devkitty.app/",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/fetch-releases.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint --fix",
    "lint:check": "eslint src",
    "typecheck": "tsc -p tsconfig.json",
    "test:e2e": "playwright test",
    "budget": "node scripts/budget.mjs"
  },
  "dependencies": {
    "@fontsource-variable/baloo-2": "^5.3.0",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/chewy": "^5.3.0",
    "@fontsource/gochi-hand": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "motion": "^14.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@egor.xyz/eslint-config": "^3.5.0",
    "@playwright/test": "^1.65.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-svgr": "^5.2.0",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "packageManager": "pnpm@11.23.0"
}
